// =============================================================================
// chatpipe: НАСТРОЙКИ ПОЛЬЗОВАТЕЛЯ
// =============================================================================
// Формат: JSON с комментариями. Строки, начинающиеся с //, - пояснения.
// Обычный JSON комментариев не допускает, поэтому у файла расширение .jsonc.
//
// Как редактировать:
//   * комментарии пишутся ТОЛЬКО на отдельных строках (строка начинается с //);
//   * текст - в двойных кавычках; true/false - да/нет; null - 'не задано';
//   * запятая нужна после каждого поля, кроме последнего в своём разделе.
//
// Этот файл создаёт и обновляет программа. При каждом сохранении комментарии
// собираются заново, а ВАШИ ЗНАЧЕНИЯ сохраняются. Поэтому свои комментарии в
// файл лучше не добавлять (они пропадут), а неизвестные поля будут удалены.
// =============================================================================

{
  // Версия формата самого файла настроек.
  // Не меняйте вручную: по ней программа поймёт, как читать старый файл.
  "settings_version": 1,

  // ИСТОЧНИК ДАННЫХ: чьи чаты мы обрабатываем и как они были выгружены.
  "source": {
    // Какая ИИ-модель вела чаты. Примеры: gemini, claude, deepseek.
    // Выбирается в меню (stage0).
    "model": "gemini",

    // Каким способом сделан экспорт чатов.
    // Допустимые значения зависят от модели. Для gemini сейчас: takeout-html.
    "export_method": "takeout-html",

    // Итоговый профиль источника (модель + способ экспорта).
    // По нему программа выбирает адаптер, который умеет читать этот формат.
    // Обычно равен model + '-' + export_method; меню заполняет его само.
    // Список доступных профилей: python3 run_stage1.py --list-profiles
    "profile_id": "gemini-takeout-html"
  },

  // ПАПКИ. Можно писать относительно папки программы или полным путём
  // (например /home/earthling/chatpipe/inbox/).
  "paths": {
    // Входящие: сюда stage0 кладёт полученный экспорт (архив или файлы).
    "inbox": "inbox/",

    // Рабочая папка: распакованные данные и промежуточные файлы.
    // Её можно очищать после того, как весь конвейер отработал без ошибок.
    "work": "work/",

    // Куда стадии кладут результаты (карточки, отчёты, пачки для ИИ).
    // Для stage1 это значение можно переопределить флагом -o.
    // Всё здесь МОЖНО пересоздать заново, поэтому папку не жалко очистить.
    "output": "output/",

    // ВАШИ ДАННЫЕ: словарь понятий, аннотации (метки и статусы карточек), правила.
    // Это результат вашей ручной работы, его нельзя получить заново из экспорта.
    // Делайте резервные копии этой папки! Она небольшая, копировать её легко.
    "user_data": "user-data/"
  },

  // АВТОЗАПУСК по расписанию. По умолчанию выключен: пока вы сами не включите
  // его через меню, автоматически не происходит НИЧЕГО.
  "automation": {
    // Включён ли автозапуск: true (да) или false (нет).
    "enabled": false,

    // Расписание автозапуска. Пока null (не задано).
    // Формат появится вместе с меню автозапуска (в духе cron).
    // Имеет смысл, только если enabled = true.
    "schedule": null
  },

  // ЛИМИТЫ.
  "limits": {
    // Максимальный размер одной 'пачки' текста для ИИ, в СИМВОЛАХ (не в байтах:
    // кириллица в UTF-8 занимает 2 байта, поэтому 100 КБ русского текста - это
    // около 50 тысяч символов).
    // Меньше пачка - внимательнее читает модель, но больше обращений к ней.
    // 80000 - стартовое значение, его нужно подобрать пробой на одной теме.
    "bundle_max_chars": 80000
  },

  // Путь к текстовому файлу правил меток-якорей (его создаёт меню правил).
  // null - используется файл по умолчанию в папке paths.user_data.
  "anchor_rules_file": null,

  // ЭТАП 2: разметка карточек метками и сборка пачек для ИИ.
  // Пустые (null) пути означают 'файл по умолчанию в папке paths.user_data'.
  "stage2": {
    // Файл карточек, который сделал stage1 (chatpipe_cards_stage1.jsonl).
    // null - искать в папке paths.output.
    "cards_file": null,

    // Файл словаря понятий. null - chatpipe_dictionary_stage2.txt в папке user_data.
    "dictionary_file": null,

    // Файл аннотаций (метки и статусы карточек).
    // null - chatpipe_annotations_stage2.jsonl в папке user_data.
    "annotations_file": null,

    // Файл 'пустых' слов (по слову на строку), которые не показываются как значимые.
    // Добавляется к встроенному списку. null - только встроенный список.
    "stopwords_file": null,

    // Приводить русские слова к начальной форме (нужна библиотека pymorphy3).
    // true - да (если библиотеки нет, программа сама перейдёт в простой режим);
    // false - никогда не использовать, сравнивать слова как есть.
    "use_lemmas": true,

    // Во сколько раз слова из ЗАПРОСА весят больше слов ответа при поиске значимых слов.
    // 1 - одинаково; 2 - запрос вдвое важнее (стартовое значение).
    "prompt_weight": 2,

    // Сколько значимых слов карточки показывать в меню разметки.
    "keywords_shown": 10,

    // Сколько предложений показывать ДО и ПОСЛЕ найденного предложения со словом.
    "sentence_window": 1
  }
}
